# =========================================================
# GULF TAXIS DISPATCH CLOUD SYSTEM - ENVIRONMENT CONFIGURATION
# =========================================================

# Node server port (default 3000)
PORT=3000

# Node environment: 'development' | 'production'
NODE_ENV=production

# Application URL for callbacks and public assets
APP_URL=https://your-domain-or-vps-ip.com

# JWT Secret for signing authentication session tokens
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_production

# Optional Database Configurations:
# Default embedded relational SQLite: storage in ./data/gulf_taxis.sqlite
# For PostgreSQL deployments on Hostinger VPS, Railway, Supabase:
# DATABASE_URL=postgresql://user:password@hostname:5432/gulf_taxis_db

# Business Timezone default
TZ=Asia/Riyadh
