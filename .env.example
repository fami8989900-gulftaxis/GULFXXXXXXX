# =========================================================
# GULF TAXIS DISPATCH CLOUD SYSTEM - ENVIRONMENT CONFIGURATION
# =========================================================

# Node server port (Hostinger sets this automatically, default 3000)
PORT=3000

# Node environment: 'development' | 'production'
NODE_ENV=production

# Application URL for callbacks and public assets
APP_URL=https://your-domain.com

# JWT Secret for signing authentication session tokens (MUST be set in production!)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_production

# Business Timezone default
TZ=Asia/Riyadh

# =========================================================
# DATABASE ARCHITECTURE NOTES:
# =========================================================
# Current Database Engine:
# Embedded persistent SQL engine (sql.js / SQLite 3)
# Active File Path: ./data/gulf_taxis.sqlite (with automated snapshots in ./data/backups)
#
# If migrating to Hostinger MySQL:
# 1. Import database_schema.sql into your Hostinger MySQL database via phpMyAdmin.
# 2. Configure:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=u123456789_gulf
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=u123456789_gulf_dispatch

